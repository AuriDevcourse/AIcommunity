# Local dev only. Copy to .env.local and adjust as needed.

# Shows the floating Feedback button. Requires a backend — the Vite dev server
# middleware (`npm run dev`) or the Node server (`npm start`).
# On a static host (Vercel/GitHub Pages) leave this unset: there is no /api
# there, and the button hides itself anyway if the API can't be reached.
VITE_FEEDBACK_ENABLED=true

# Production server only (server.js):
#   PORT         listen port (default 3003)
#   HOST         bind address (default 0.0.0.0)
#   DATA_DIR     where poll.json + feedback.md live (default ./data)
#   TRUST_PROXY  reverse-proxy hops to trust (default 1; "false" to disable)
#   ADMIN_TOKEN  optional escape hatch to delete a poll whose creator token is lost
#   FEEDBACK_LOG_PUBLIC  "true" to let the in-app panel show past feedback
#                        entries (with names) to every visitor. Default: off —
#                        the panel only reports how many entries exist.
