# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# Production reads Vercel's own project env, so anything set here must be set there too.
#
# Everything is optional: each feature degrades to a documented fallback when its
# keys are missing, so the app runs with an empty file.

# ---------------------------------------------------------------- Auth (Supabase)
# Without these the app runs in typed-name mode: reads stay open, and the API
# guards accept a name from the request body because there is no session to trust.
# The anon/publishable key is safe in the client. NEVER put a service_role or
# sb_secret_ key here: VITE_ vars are compiled into the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------- Store (Upstash Redis/KV)
# Backs polls, forum threads, topics, RSVPs and session names. Without it those
# features report "needs a Redis store" instead of failing. Locally a JSON file
# under data/ is used instead; on Vercel the filesystem is read-only, so the store
# is required there. Either naming works, whichever the integration injects.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------- Photo uploads (Vercel Blob)
# Without it the uploader says uploads are not connected. Committed photos under
# public/sessions/ still render.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# ----------------------------------------------------------------- Google Calendar
# Drives the live schedule and, where guests are invited, the Coming list. Reads as
# the organiser via a stored refresh token, because attendee RSVP status is private
# and no public API key can see it. Mint the token once: npm run google:auth
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
# The calendar to read. Leave unset and it uses 'primary', the account's main
# calendar, where the app has to pick sessions out by title.
#
# Prefer a DEDICATED calendar holding nothing but sessions. Setting this to any
# value other than 'primary' switches the title filter OFF, because every event in
# such a calendar is a session. Get the value from Google Calendar settings ->
# the calendar -> Integrate calendar -> "Calendar ID". It ends in
# @group.calendar.google.com.
GCAL_CALENDAR_ID=
# Escape hatch. Comma-separated title substrings; any one matching wins. Only
# needed on a shared calendar, or to filter a dedicated one anyway.
# Defaults to the community's current and former name.
# GCAL_EVENT_MATCH=AI Sundays,AI Workshop

# ------------------------------------------------------------------ Post maker (LLM)
# Turns a session into a LinkedIn or Instagram draft. Without a key the tool says
# it is not configured. Gemini is tried first, OpenRouter is the fallback.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
# POST_MODEL=

# ------------------------------------------------------- Image hosting (ImgBB proxy)
# Backs the forum image uploads and the Image-to-link tool. Server-side only: the
# browser calls /api/upload-image, so the key never reaches the client.
IMGBB_API_KEY=

# ------------------------------------------------------------- Self-host (server.js)
# Only for `npm start`. Vercel is production; server.js is a parked runtime.
# PORT=3003
# DATA_DIR=
